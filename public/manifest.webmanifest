{
  "name": "Scope Ledger",
  "short_name": "Scope Ledger",
  "description": "Find every extra request in your client chats and turn it into a priced add-on.",
  "start_url": "/app.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#172033",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "file", "accept": ["text/plain", ".txt", "application/zip", ".zip"] }]
    }
  }
}
